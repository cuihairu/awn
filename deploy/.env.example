# 复制为 .env 并填写真实值（.env 已被 .gitignore 排除，不入库）

# PostgreSQL（交易库 + Worker 共用）
AWN_DB_PASSWORD=

# RustFS 对象存储（S3 兼容；控制台默认账号 rustfsadmin 需改为以下值）
RUSTFS_ACCESS_KEY=awn_storage
RUSTFS_SECRET_KEY=

# 情报库角色（init-intel.sql 中的占位密码需同步修改）
AWN_INTEL_PASSWORD=

# Docker 构建依赖源（可选；出口网络受限时取消注释）
# CENTRAL_MIRROR=https://maven.aliyun.com/repository/central
